subscription_id = "00000000-0000-0000-0000-000000000000"
tenant_id       = "00000000-0000-0000-0000-000000000000"
common_prefix   = "agilis"
location        = "eastus"

# Optional additional tags merged with the defaults defined in the root module.
tags = {
  owner = "platform-team"
}

# Keep Premium v3 for production by default.
app_service_sku_name = "P1v3"

# Cosmos DB production sizing
cosmos_mongo_database_max_throughput = 4000
cosmos_free_tier_enabled             = false
cosmos_enable_automatic_failover     = true
cosmos_account_name_suffix           = "prod"
